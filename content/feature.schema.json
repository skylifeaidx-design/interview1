{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"상담 가이드북 기능",
  "type":"object",
  "required":["id","title","major","middle","minor","menu","url","route","summary","aliases","steps","note","login","product","action","external","screen","script","availability"],
  "properties":{
    "$schema":{"type":"string"},
    "id":{"type":"string","pattern":"^f-[a-f0-9]{10}$","description":"기존 공유 링크를 유지하기 위해 수정하지 않습니다."},
    "title":{"type":"string","minLength":1},"major":{"type":"string","minLength":1},"middle":{"type":"string","minLength":1},"minor":{"type":"string","minLength":1},
    "menu":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "url":{"type":"string","format":"uri","pattern":"^https://"},"route":{"type":"string","minLength":1},
    "summary":{"type":"string","minLength":1},"aliases":{"type":"array","items":{"type":"string","minLength":1}},
    "steps":{"type":"array","minItems":3,"items":{"type":"string","minLength":1}},
    "note":{"type":"string","minLength":1},"login":{"type":"boolean"},"product":{"enum":["공통","TV","인터넷","TV·인터넷","모바일","사업자"]},
    "action":{"type":"string","minLength":1},"external":{"type":"boolean"},"sourceVerified":{"type":"boolean"},"script":{"type":"string","minLength":1},"priority":{"type":"integer","minimum":0},
    "availability":{"type":"object","required":["mode","label","reviewedAt"],"properties":{"mode":{"enum":["action","lookup","guide","external"]},"label":{"type":"string","minLength":1},"reviewedAt":{"type":"string","format":"date"}},"additionalProperties":false},
    "screen":{"type":"object","required":["src","kind","caption","captured"],"properties":{"src":{"type":"string","pattern":"^screens/[a-zA-Z0-9_-]+\\.(jpg|jpeg|png)$"},"kind":{"enum":["live","authenticated","source","login"]},"caption":{"type":"string","minLength":1},"captured":{"type":"string","format":"date"},"url":{"type":"string","format":"uri","pattern":"^https://"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
