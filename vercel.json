{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts",
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"Strict-Transport-Security","value":"max-age=31536000"},
      {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}
    ]
  },{
    "source":"/skylife-counselor-guide.html",
    "headers":[{"key":"Content-Disposition","value":"attachment; filename=\"skylife-counselor-guide.html\""}]
  }]
}
